{
  "name": "lwkfall",
  "version": "0.1.0",
  "description": "Tiny, dependency-free falling effects for any website: leaves, autumn, maple, cherry blossom, snow, rose petals and more.",
  "keywords": [
    "falling leaves",
    "snow",
    "cherry blossom",
    "sakura",
    "petals",
    "autumn",
    "canvas",
    "particles",
    "animation",
    "effect",
    "react"
  ],
  "author": "Moon <https://github.com/LwkMoon>",
  "license": "MIT",
  "homepage": "https://github.com/LwkMoon/lwkfall#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LwkMoon/lwkfall.git"
  },
  "bugs": {
    "url": "https://github.com/LwkMoon/lwkfall/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo": "npm run build && node scripts/standalone.mjs"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
